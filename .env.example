# ==============================================================================
# AuraDrive - Environment Configuration Template
# Copy this file to `.env` in the project root: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# FREE SMTP EMAIL SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION 1: Gmail (Free, 500 emails/day, requires 2-Step Verification + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=AuraDrive Security
SMTP_USE_TLS=true

# OPTION 2: Brevo / Sendinblue (Free, 300 emails/day, no personal email password)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASSWORD=your_brevo_smtp_key
# SMTP_FROM_EMAIL=verified_sender@yourdomain.com
# SMTP_FROM_NAME=AuraDrive Security
# SMTP_USE_TLS=true

# OPTION 3: Outlook / Microsoft 365 (Free)
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your_account@outlook.com
# SMTP_PASSWORD=your_password
# SMTP_FROM_EMAIL=your_account@outlook.com
# SMTP_FROM_NAME=AuraDrive Security
# SMTP_USE_TLS=true
